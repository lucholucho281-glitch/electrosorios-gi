function verDetalles(nombreProducto) {
  const texto = detalles[nombreProducto];
  document.getElementById("detalle-texto").textContent = texto;
  document.getElementById("detalle-producto").style.display = "block";
}

// Calcular total
function actualizarTotal() {
  let total = 0;
  const items = carritoLista.querySelectorAll("li");

  items.forEach(item => {
    const texto = item.querySelector("span").textContent;
    const precioTexto = texto.split(" - $")[1];
    const precio = parseFloat(precioTexto);
    total += precio;
  });

  totalElemento.textContent = `Total: $${total.toFixed(2)}`;
}